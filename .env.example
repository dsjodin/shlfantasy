# Claude API-nyckel för AI-rådgivaren (skapa på https://console.anthropic.com).
# Utan nyckel fungerar allt utom AI-rådgivaren.
ANTHROPIC_API_KEY=

# Valfritt
# CLAUDE_MODEL=claude-opus-5-5
# CLAUDE_EFFORT=medium        # low | medium | high – högre = grundligare men dyrare/långsammare
# AI_WEB_SEARCH=true          # låt AI:n söka nyheter om skador och laguppställningar
# REFRESH_MINUTES=60          # hur ofta data hämtas från fantasy.shl.se och shl.se
